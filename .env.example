# ====================================
# FRONTEND - Variáveis de Ambiente
# ====================================

# URL da API Backend em produção
# Altere para o endereço real do seu backend no Cloudez
VITE_API_URL=https://seu-backend-api.cloudez.com/api

# Chat conversacional — mantenha false até o workflow N8N estar finalizado
# O widget só carrega se VITE_ENABLE_CHAT=true (opt-in explícito no build)
VITE_ENABLE_CHAT=false

# ====================================
# N8N — Chat Conversacional (Sprint 4.0.2)
# ====================================
# URL do webhook conversacional do N8N (não ativa o chat sozinha)
VITE_N8N_CHAT_WEBHOOK_URL=

# ====================================
# DESENVOLVIMENTO LOCAL (opcional)
# ====================================
# Para desenvolvimento local, descomente:
# VITE_API_URL=http://localhost:5000/api
# VITE_N8N_CHAT_WEBHOOK_URL=http://localhost:5678/webhook/chat-message

# ====================================
# BUILD DE PRODUÇÃO
# ====================================
# Antes de npm run build, copie .env.production.example → .env.production
# Confirme VITE_ENABLE_CHAT=false e webhook N8N vazio.
# Depois envie a pasta dist/ via FileZilla (substituir a dist antiga no servidor).
