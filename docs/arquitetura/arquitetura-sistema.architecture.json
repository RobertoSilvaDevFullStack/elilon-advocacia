  "cards": [
    {
      "dot": "cyan",
      "title": "Navegador",
      "items": [
        "SPA React 19 com React Router 7, empacotada pelo Vite",
        "O painel /admin é rota da mesma SPA, não outro deploy",
        "O ChatWidget chama o webhook do n8n direto do cliente"
      ]
    },
    {
      "dot": "emerald",
      "title": "API e estado",
      "items": [
        "Express em Node :5000 com helmet, CORS allowlist e rate limit por rota",
        "PostgreSQL via pg Pool; DATABASE_TYPE alterna para SQLite em dev",
        "Documentos do chat ficam em disco, não no banco"
      ]
    },
    {
      "dot": "rose",
      "title": "Segurança e integrações",
      "items": [
        "JWT Bearer com middleware adminOnly nas rotas /api/admin",
        "Webhook do Asaas validado por ASAAS_WEBHOOK_TOKEN",
        "Leads de /api/leads também vão ao CRM Exact Sales quando habilitado"
      ]
    }
  ]
