# ====================================
# CONFIGURAÇÃO DO SERVIDOR
# ====================================
PORT=5000
NODE_ENV=production

# ====================================
# DATABASE (PostgreSQL)
# ====================================
# Preencha com as credenciais criadas no Cloudez
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elilon_advocacia_db
DB_USER=elilon_db_user
DB_PASSWORD=SUA_SENHA_AQUI

# Email Configuration
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password

# Exact Sales Integration
EXACT_SALES_API_URL=https://api.exactsales.com.br/v2
EXACT_SALES_TOKEN=your_exact_sales_token_here
EXACT_SALES_ENABLED=true

# ====================================
# AUTENTICAÇÃO
# ====================================
# Gere uma string aleatória forte para JWT_SECRET
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GERAR_STRING_ALEATORIA_64_CARACTERES

# Senha inicial do usuário admin (obrigatória em produção no primeiro deploy)
ADMIN_INITIAL_PASSWORD=defina_senha_forte_aqui

# Secret para assinar webhook interno diagnostico_pago (N8N)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DIAGNOSTICO_PAGO_WEBHOOK_SECRET=GERAR_STRING_ALEATORIA_32_CARACTERES

# ====================================
# CORS
# ====================================
# URL do frontend em produção (redirect ASAAS pós-pagamento, CORS)
# Cadastre o domínio em ASAAS: Minha Conta → Informações → URLs de retorno
# Dev local: use a porta do Vite (padrão 5173) ou túnel (ngrok) se testar redirect no sandbox
FRONTEND_URL=https://seu-dominio.cloudez.com

# ====================================
# OPÇÃO: SQLite (se não usar PostgreSQL)
# ====================================
# Se decidir continuar com SQLite, comente as variáveis DB_* acima
# e mantenha DATABASE_TYPE=sqlite
DATABASE_TYPE=postgres
# ====================================
# ASAAS — Pagamentos Diagnóstico Premium (Sprint 3.11)
# ====================================
# Sandbox: https://sandbox.asaas.com/api/v3
# Produção: https://api.asaas.com/api/v3
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
# Chaves ASAAS começam com $ — use aspas duplas para evitar corrupção pelo dotenv
ASAAS_API_KEY="$aact_sua_chave_aqui"
# Token para validar webhooks recebidos do ASAAS (32+ bytes hex recomendado)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ASAAS_WEBHOOK_TOKEN=seu_token_webhook_asaas_aqui

# DATABASE_TYPE=sqlite
