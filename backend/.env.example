# ====================================
# CONFIGURAÇÃO DO SERVIDOR
# ====================================
PORT=5000
NODE_ENV=production

# ====================================
# DATABASE (PostgreSQL)
# ====================================
# Preencha com as credenciais criadas no Cloudez
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elilon_advocacia_db
DB_USER=elilon_db_user
DB_PASSWORD=SUA_SENHA_AQUI

# ====================================
# AUTENTICAÇÃO
# ====================================
# Gere uma string aleatória forte para JWT_SECRET
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GERAR_STRING_ALEATORIA_64_CARACTERES

# ====================================
# CORS
# ====================================
# URL do frontend em produção
FRONTEND_URL=https://seu-dominio.cloudez.com

# ====================================
# OPÇÃO: SQLite (se não usar PostgreSQL)
# ====================================
# Se decidir continuar com SQLite, comente as variáveis DB_* acima
# e mantenha DATABASE_TYPE=sqlite
DATABASE_TYPE=postgres
# DATABASE_TYPE=sqlite
