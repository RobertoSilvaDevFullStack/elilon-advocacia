# ============================================
# CONFIGURAÇÃO DO SERVIDOR - DESENVOLVIMENTO
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# DATABASE
# ============================================
# SQLite para desenvolvimento local
DATABASE_TYPE=sqlite

# PostgreSQL - descomente se quiser testar com PostgreSQL local
# DATABASE_TYPE=postgres
# DATABASE_URL=postgresql://elilon_db_user:senha@localhost:5432/elilon_advocacia_db

# ============================================
# AUTENTICAÇÃO
# ============================================
JWT_SECRET=desenvolvimento_jwt_secret_key_elilon_advocacia_2026

# ============================================
# CORS
# ============================================
# URL do frontend local
FRONTEND_URL=http://localhost:3000

# ============================================
# Email Configuration (Optional)
# ============================================
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password

# ============================================
# Exact Sales Integration (Optional)
# ============================================
EXACT_SALES_API_URL=https://api.exactsales.com.br/v2
EXACT_SALES_TOKEN=your_exact_sales_token_here
EXACT_SALES_ENABLED=false
